/// The Databricks workspace's host name, without https:// (from the CLI profile).
expression DatabricksHost = "{{host}}" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// The SQL warehouse's HTTP path, /sql/1.0/warehouses/<id> (from the workspace).
expression DatabricksHttpPath = "{{http_path}}" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// The Unity Catalog catalog and schema the pipeline's publish task writes to (from the bundle target).
expression DatabricksCatalog = "{{catalog}}" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

expression DatabricksSchema = "{{schema}}" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Reads one table from Unity Catalog through a SQL warehouse. Generated by tools/report for
/// Databricks; the model in powerbi/ reads local Delta tables with the same function.
expression DeltaTable =
		(name as text) as table =>
		let
			Source = Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
			Catalog = Source{[Name = DatabricksCatalog, Kind = "Database"]}[Data],
			Schema = Catalog{[Name = DatabricksSchema, Kind = "Schema"]}[Data],
			Table = Schema{[Name = name, Kind = "Table"]}[Data]
		in
			Table
