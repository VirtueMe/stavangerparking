/// The Lakehouse's SQL analytics endpoint: its connection string, from the endpoint's settings.
expression FabricSqlEndpoint = "{{sql_endpoint}}" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// The Lakehouse's name, which is the endpoint's database.
expression FabricLakehouse = "{{lakehouse}}" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Reads one Lakehouse table through the SQL analytics endpoint, in import mode. Generated by
/// tools/report for Fabric (#16-#19); not yet tested against a Fabric workspace. Direct Lake would
/// need other partitions, not another function.
expression DeltaTable =
		(name as text) as table =>
		let
			Source = Sql.Database(FabricSqlEndpoint, FabricLakehouse),
			Table = Source{[Schema = "dbo", Item = name]}[Data]
		in
			Table
