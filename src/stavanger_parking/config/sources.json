{
  "sources": [
    {
      "id": "stavanger_parking",
      "ckan": {
        "base_url": "https://opencom.no",
        "package_id": "stavanger-parkering",
        "format": "json"
      },
      "raw_path": "bronze/parking/{yyyy}/{mm}/{dd}/{HHmmss}.json",
      "bronze_table": "bronze_parking",
      "licence": {
        "id": "NLOD-2.0",
        "url": "https://data.norge.no/nlod/no/2.0/",
        "publisher": "Stavanger kommune"
      },
      "polling": {
        "fast_interval_minutes": 5,
        "slow_interval_minutes": 20,
        "unchanged_snapshots_for_slow": 5,
        "change_ignores_fields": [
          "Dato",
          "Klokkeslett"
        ]
      },
      "freshness": {
        "stale_after_minutes": 15
      }
    },
    {
      "id": "parkeringsregisteret",
      "http": {
        "url": "https://parkreg-open.atlas.vegvesen.no/ws/no/vegvesen/veg/parkeringsomraade/parkeringsregisteret/v1/parkeringsomraade?orgnr=974782766&datafelter=alle"
      },
      "raw_path": "bronze/parkeringsregisteret/{yyyy}/{mm}/{dd}/{HHmmss}.json",
      "bronze_table": "bronze_parkeringsregisteret",
      "licence": {
        "id": "NLOD-2.0",
        "url": "https://data.norge.no/nlod/no/2.0/",
        "publisher": "Statens vegvesen"
      },
      "polling": {
        "fast_interval_minutes": 60,
        "slow_interval_minutes": 60,
        "unchanged_snapshots_for_slow": 5,
        "change_ignores_fields": []
      },
      "filter": {
        "field": "id",
        "mapping_field": "register_id"
      }
    }
  ]
}
