{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "facility-map",
  "position": {
    "x": 16,
    "y": 60,
    "z": 3000,
    "height": 612,
    "width": 820,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "azureMap",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_parking_facility"
                    }
                  },
                  "Property": "facility_name"
                }
              },
              "queryRef": "dim_parking_facility.facility_name",
              "nativeQueryRef": "facility_name"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "dim_parking_facility"
                        }
                      },
                      "Property": "longitude"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(dim_parking_facility.longitude)",
              "nativeQueryRef": "Average of longitude"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "dim_parking_facility"
                        }
                      },
                      "Property": "latitude"
                    }
                  },
                  "Function": 1
                }
              },
              "queryRef": "Avg(dim_parking_facility.latitude)",
              "nativeQueryRef": "Average of latitude"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_parking_availability"
                    }
                  },
                  "Property": "Free spaces (latest)"
                }
              },
              "queryRef": "fact_parking_availability.Free spaces (latest)",
              "nativeQueryRef": "Free spaces (latest)"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_parking_availability"
                    }
                  },
                  "Property": "Capacity"
                }
              },
              "queryRef": "fact_parking_availability.Capacity",
              "nativeQueryRef": "Capacity"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_parking_hourly"
                    }
                  },
                  "Property": "Occupancy"
                }
              },
              "queryRef": "fact_parking_hourly.Occupancy",
              "nativeQueryRef": "Occupancy"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Free spaces now, by facility'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
